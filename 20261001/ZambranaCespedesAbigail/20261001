package temperatura;

import java.util.Locale;
import java.util.Scanner;

/**
 *
 * @author ace6601
 */
public class Temperatura{

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        double kelvin, celsius, fahrenheit;
        
        // Forcem l'ús del punt decimal (.) independentment de l'idioma del sistema
        Scanner teclat = new Scanner(System.in).useLocale(Locale.US);

        System.out.println("Digues la temperatura en graus Kelvin:");
        kelvin = teclat.nextDouble();

        // Fórmula per passar de Kelvin a Celsius
        celsius = kelvin - 273.15;
        
        // Fórmula per passar de Celsius a Fahrenheit
        fahrenheit = (celsius * 9.0 / 5.0) + 32;

        System.out.println("La temperatura en graus Celsius es " + celsius);
        System.out.println("La temperatura en graus Fahrenheit es " + fahrenheit);
    }
}
