package conversiomillesametres;

import java.util.Locale;
import java.util.Scanner;

/**
 *
 * @author ace6601
 */
public class Conversiomillesametres {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        double millesNautiques, metres;
        final double METRES_PER_MILLA = 1852; // 1 milla nàutica = 1852 metres

        // Scanner amb Locale.US per utilitzar el punt (.) decimal
        Scanner teclat = new Scanner(System.in).useLocale(Locale.US);

        System.out.println("Digues la distància en milles nàutiques:");
        millesNautiques = teclat.nextDouble();

        // Fórmula de conversió
        metres = millesNautiques * METRES_PER_MILLA;

        System.out.println("La distància en metres es " + metres);
    }
}


