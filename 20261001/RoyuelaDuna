public class ExGrados {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        // TODO code application logic here
        Scanner teclat = new Scanner(System.in);
        double Kelvin, Celsius, Farenheit;
        final double KelvinACelsius = 273.15;
        System.out.println("Que temperatura en Kelvin hace??");
        Kelvin = teclat.nextDouble();
        Celsius = Kelvin - KelvinACelsius;
        Farenheit = (Celsius*9/5)+32;
        System.out.println("En Celsius son" + Celsius);
        System.out.println("En Farenheit son" + Farenheit);
        
    }
    
}

