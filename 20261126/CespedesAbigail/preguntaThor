package preguntathor;
import java.util.Scanner;

public class PreguntaThor {

    public static void main(String[] args) {

        String respuesta;
        int resultado;

        respuesta = PrimeraPregunta();

        resultado = respostaPrimera(respuesta);

        System.out.println("Puntuacion: " + resultado);

    }

    public static String PrimeraPregunta()
    {
        Scanner sc = new Scanner(System.in);

        String respuesta;

        System.out.println("¿Como se llama el martillo de Thor?");
        System.out.println("A) Mjolnir");
        System.out.println("B) Jonathan");
        System.out.println("C) Martillo");
        System.out.println("D) Martithor");

        respuesta = sc.nextLine();

        respuesta = respuesta.toUpperCase();

        return respuesta;
    }

    public static int respostaPrimera(String respuesta)
    {
        if (respuesta.equals("MJOLNIR"))
        {
            System.out.println("Respuesta correcta");
            return 1;
        }

        if (respuesta.equals("JONATHAN"))
        {
            System.out.println("No. Jonathan no es correcto, aunque Paul Rudd diria que si.");
            return 0;
        }

        if (respuesta.equals("MARTILLO"))
        {
            System.out.println("Sabes lo que es, pero no como se llama.");
            return 0;
        }

        if (respuesta.equals("MARTITHOR"))
        {
            System.out.println("Ese nombre te lo has inventado.");
            return 0;
        }
        
        else
        {
            System.out.println("Respuesta no valida.");
            return 0;
        }

        

        
    }

}
