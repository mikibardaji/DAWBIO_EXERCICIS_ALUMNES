import java.util.Scanner;

public class Ejercicio12 {
    public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);

        System.out.print("Introduce el precio: ");
        double precio = teclado.nextDouble();

        System.out.print("Introduce cuánto pagas: ");
        double pago = teclado.nextDouble();

        if (pago > precio) {
            System.out.println("Sobran " + (pago - precio) + " euros");
        } else if (pago < precio) {
            System.out.println("Faltan " + (precio - pago) + " euros");
        } else {
            System.out.println("Has pagado la cantidad exacta");
        }

        teclado.close();
    }
}

