public class SantamariaMoralesDylanExercicisEstructuresCondicionals3 {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        // 3. Programa que llegeix 2 números i en mostra el més gran.
        Scanner lector = new Scanner(System.in);
        double num1, num2;
        
        System.out.println("Introdueix els dos nombres per comparar: ");
        System.out.print("Número 1: ");
        num1 = lector.nextDouble();
        System.out.print("Número 2: ");
        num2 = lector.nextDouble();
        
        if (num1 > num2){
            System.out.println("El Número 1: " + num1 + "és el més gran.");
        }
        else{
            if (num1 == num2){
                System.out.println("Els dos nombres són iguals.");
            }else{
                System.out.println("El Número 2: " + num2 + "és el més gran.");                
            }
            
        }
        
    }
    
}
