package ex4comptadorparells;

import java.util.Scanner; // Corregit: faltava el punt i coma final

/**
 * Programa que entra un número natural N i mostra els números parells compresos entre 1 i N. Per fer-ho utilitzeu un comptador sumant d'1 en 1.
 * @author ace6601
 */
public class Ex4ComptadorParells {

    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        
        int numero;
        
        System.out.println("digues un numero");
        numero = scan.nextInt();
        
        // El comptador comença a 1 i va sumant d'1 en 1 (i++)
        for (int i = 1; i <= numero; i++) {
            // Comprovem si el número actual és parell
            if (i % 2 == 0) {
                System.out.println("Numero parell: " + i);
            }
        }
        
    }
    
}
